\n        end\n    ","id":"college-info-agent"}],["$","div",null,{"style":{"border":"1px dashed var(--border-color)","padding":"1.5rem","margin":"1rem 0","fontFamily":"monospace","fontSize":"0.9rem","whiteSpace":"pre-wrap","display":"none"},"children":[["$","div","0",{"children":"> Ingestion Service: PDF text extraction -> Chunking -> Embedding"}],["$","div","1",{"children":"> Vector Store: ChromaDB (Local persistence)"}],["$","div","2",{"children":"> Retrieval: Semantic search with metadata filtering (College ID)"}],["$","div","3",{"children":"> Generation: LLM (Gemini/OpenAI) grounded in retrieved context"}],["$","div","4",{"children":"> Frontend: React Admin Dashboard for document management"}]]}],["$","p",null,{"className":"text-sec","children":"Built a Retrieval-Augmented Generation (RAG) pipeline that ingests PDFs, chunks and embeds them into a local vector store (ChromaDB), and retrieves relevant context for an LLM to answer queries accurately with citations."}]]}],["$","div",null,{"className":"case-study-section mb-2","children":[["$","h3",null,{"children":"03_Key Technical Decisions"}],["$","ul",null,{"style":{"listStyle":"none","padding":0},"children":[["$","li","0",{"style":{"marginBottom":"1rem","paddingLeft":"1rem","borderLeft":"2px solid var(--border-color)"},"children":[["$","strong",null,{"style":{"color":"var(--text-primary)"},"children":"Decision:"}]," ",["$","span",null,{"className":"text-sec","children":"Chosen ChromaDB for local, lightweight vector storage without cloud overhead."}]]}],["$","li","1",{"style":{"marginBottom":"1rem","paddingLeft":"1rem","borderLeft":"2px solid var(--border-color)"},"children":[["$","strong",null,{"style":{"color":"var(--text-primary)"},"children":"Decision:"}]," ",["$","span",null,{"className":"text-sec","children":"Implemented Multi-tenancy via College ID metadata tagging to isolate knowledge bases."}]]}],["$","li","2",{"style":{"marginBottom":"1rem","paddingLeft":"1rem","borderLeft":"2px solid var(--border-color)"},"children":[["$","strong",null,{"style":{"color":"var(--text-primary)"},"children":"Decision:"}]," ",["$","span",null,{"className":"text-sec","children":"Used Hybrid Search (Keyword + Semantic) to improve retrieval accuracy for specific terms (e.g., course codes)."}]]}]]}]]}],"$L11","$L12"]}]
