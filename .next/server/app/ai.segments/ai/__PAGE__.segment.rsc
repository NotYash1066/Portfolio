0:{"buildId":"ZiOuFn2zAZKEdiDOI3iIs","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"section-container","children":[["$","h1",null,{"children":"[04] AI, Used Practically"}],["$","p",null,{"style":{"marginBottom":"3rem"},"children":"AI is a tool, not a magic wand. My approach emphasizes restraint, using deterministic code where possible and LLMs only where necessary."}],["$","div",null,{"className":"ai-principles mb-2","children":[["$","h3",null,{"children":"Principles"}],["$","ul",null,{"style":{"listStyle":"none","padding":0},"children":[["$","li",null,{"style":{"marginBottom":"1rem"},"children":[["$","strong",null,{"children":"01. Determinstic First:"}]," Check rules before calling an LLM. If a regex works, use it."]}],["$","li",null,{"style":{"marginBottom":"1rem"},"children":[["$","strong",null,{"children":"02. Grounded Generation:"}]," Never let an LLM hallucinate. Always supply retrieval context (RAG)."]}],["$","li",null,{"style":{"marginBottom":"1rem"},"children":[["$","strong",null,{"children":"03. Cost Awareness:"}]," Use smaller models (Flash/3.5-Turbo) for structured tasks; save GPT-4 for reasoning."]}]]}]]}],["$","h2",null,{"children":"Implementation Examples"}],["$","div",null,{"className":"border-box","children":[["$","h3",null,{"children":"Safe-Plate: Hybrid Classification"}],["$","p",null,{"className":"text-sec","children":[["$","strong",null,{"children":"Why AI?"}]," Identifying obscure chemical additives that don't match exact strings in a DB."]}],["$","p",null,{"className":"text-sec","children":[["$","strong",null,{"children":"Constraint:"}]," Cost & Latency."]}],["$","p",null,{"className":"text-sec","children":[["$","strong",null,{"children":"Solution:"}]," We check a local JSON dictionary first (0ms). Only if the ingredient is unknown do we call Gemini Flash API (~400ms)."]}]]}],["$","div",null,{"className":"border-box","children":[["$","h3",null,{"children":"CollegeInfo: PDF Extraction"}],["$","p",null,{"className":"text-sec","children":[["$","strong",null,{"children":"Why AI?"}]," Unstructured tables in syllabus PDFs."]}],["$","p",null,{"className":"text-sec","children":[["$","strong",null,{"children":"Restraint:"}]," We don't summarize the ",["$","i",null,{"children":"whole"}]," PDF. We chunk it and retrieve only the relevant section to answer the student's question, reducing token usage by 90%."]}]]}]]}],null,["$","$L2",null,{"children":["$","$3",null,{"name":"Next.MetadataOutlet","children":"$@4"}]}]]}],"loading":null,"isPartial":false}
